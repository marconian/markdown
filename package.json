{
    "name": "@tauw/markdown",
    "version": "1.0.0",
    "description": "Enterprise-grade React Markdown renderer with extended syntax support for admonitions, math equations (KaTeX), Mermaid charts, spoilers, definition lists, tables, code highlighting, footnotes, and emoji. Designed for the Tauw design system.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "default": "./dist/index.mjs"
        }
    },
    "keywords": [
        "markdown",
        "react",
        "markdown-parser",
        "markdown-renderer",
        "admonitions",
        "katex",
        "mermaid",
        "syntax-highlighting",
        "footnotes",
        "tables",
        "emoji",
        "typescript",
        "tauw"
    ],
    "author": "Tauw Development Team",
    "license": "UNLICENSED",
    "private": false,
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "vite build && pnpm run build:types",
        "build:types": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"src\" --ext .ts,.tsx --max-warnings=0",
        "format": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,css,scss,md}\""
    },
    "peerDependencies": {
        "@emotion/react": "^11.0.0",
        "@emotion/styled": "^11.0.0",
        "@fortawesome/fontawesome-svg-core": "^6.0.0",
        "@fortawesome/pro-light-svg-icons": "^6.0.0",
        "@fortawesome/pro-solid-svg-icons": "^6.0.0",
        "@fortawesome/react-fontawesome": "^0.2.0",
        "@mui/material": "^7.0.0",
        "@mui/x-data-grid": "^8.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "dompurify": "^3.2.7",
        "emojilib": "^3.0.0",
        "highlight.js": "^11.9.0",
        "katex": "^0.16.11",
        "lodash": "^4.17.21",
        "mermaid": "^10.9.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@emotion/react": "^11.13.3",
        "@emotion/styled": "^11.13.0",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.39.1",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/lodash": "^4.14.202",
        "@types/node": "^22.9.0",
        "@types/react": "^19.0.1",
        "@types/react-dom": "^19.0.1",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^8.46.3",
        "@typescript-eslint/parser": "^8.46.3",
        "@vitejs/plugin-react": "^4.3.2",
        "@vitest/coverage-v8": "^1.6.0",
        "@vitest/eslint-plugin": "^1.4.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest-dom": "^5.5.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-testing-library": "^7.13.3",
        "globals": "^16.5.0",
        "jsdom": "^27.1.0",
        "prettier": "^3",
        "typescript": "^5.6.3",
        "vite": "^5.4.9",
        "vitest": "^1.6.0"
    },
    "packageManager": "pnpm@10.3.0",
    "sideEffects": false
}
