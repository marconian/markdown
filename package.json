{
    "name": "@marconian/markdown",
    "version": "1.0.2",
    "description": "React Markdown renderer with extended syntax support for admonitions, math equations (KaTeX), Mermaid charts, spoilers, definition lists, tables, code highlighting, footnotes, and emoji.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "default": "./dist/index.mjs"
        }
    },
    "keywords": [
        "markdown",
        "react",
        "markdown-parser",
        "markdown-renderer",
        "admonitions",
        "katex",
        "mermaid",
        "syntax-highlighting",
        "footnotes",
        "tables",
        "emoji",
        "typescript",
        "marconian"
    ],
    "author": "marconian",
    "license": "MIT",
    "private": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "vite build && pnpm run build:types",
        "build:types": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"src\" --ext .ts,.tsx --max-warnings=0",
        "format": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,css,scss,md}\""
    },
    "peerDependencies": {
        "@emotion/react": "^11.0.0",
        "@emotion/styled": "^11.0.0",
        "@mui/icons-material": "^7.0.0",
        "@mui/material": "^7.0.0",
        "@mui/x-data-grid": "^8.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "dompurify": "^3.3.1",
        "emojilib": "^3.0.12",
        "highlight.js": "^11.11.1",
        "katex": "^0.16.33",
        "lodash": "^4.17.23",
        "mermaid": "^10.9.5",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@eslint/eslintrc": "^3.3.4",
        "@eslint/js": "^9.39.3",
        "@mui/icons-material": "^7.3.8",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/lodash": "^4.17.24",
        "@types/node": "^22.19.13",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/uuid": "^9.0.8",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^1.6.1",
        "@vitest/eslint-plugin": "^1.6.9",
        "eslint": "^9.39.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest-dom": "^5.5.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-testing-library": "^7.16.0",
        "globals": "^16.5.0",
        "jsdom": "^27.4.0",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "vite": "^5.4.21",
        "vitest": "^1.6.1"
    },
    "packageManager": "pnpm@10.3.0",
    "sideEffects": false
}
