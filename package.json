{
    "name": "@tauw/markdown",
    "version": "0.1.0",
    "description": "Tauw Markdown renderer components packaged as a reusable module.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "style": "./dist/styles/style.css",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "default": "./dist/index.mjs"
        },
        "./styles": {
            "default": "./dist/styles/style.css"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "pnpm run build:types && vite build",
        "build:types": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,css,scss,md}\""
    },
    "peerDependencies": {
        "@emotion/react": "^11.0.0",
        "@emotion/styled": "^11.0.0",
        "@fortawesome/fontawesome-svg-core": "^6.0.0",
        "@fortawesome/pro-light-svg-icons": "^6.0.0",
        "@fortawesome/pro-solid-svg-icons": "^6.0.0",
        "@fortawesome/react-fontawesome": "^0.2.0",
        "@mui/material": "^7.0.0",
        "@mui/x-data-grid": "^8.0.0",
        "@tauw/tauw-theme-sass": "^5.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "dompurify": "^3.2.7",
        "emojilib": "^3.0.0",
        "highlight.js": "^11.9.0",
        "katex": "^0.16.11",
        "lodash": "^4.17.21",
        "mermaid": "^10.9.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/lodash": "^4.14.202",
        "@types/node": "^22.9.0",
        "@types/react": "^19.0.1",
        "@types/react-dom": "^19.0.1",
        "@types/uuid": "^9.0.7",
        "@vitejs/plugin-react": "^4.3.2",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@emotion/react": "^11.13.3",
        "@emotion/styled": "^11.13.0",
        "@vitest/coverage-v8": "^1.6.0",
        "jsdom": "^27.1.0",
        "prettier": "^3",
        "sass": "^1.80.4",
        "typescript": "^5.6.3",
        "vite": "^5.4.9",
        "vitest": "^1.6.0"
    },
    "packageManager": "pnpm@10.3.0",
    "sideEffects": [
        "**/*.scss"
    ]
}
